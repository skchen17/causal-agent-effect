{
  "bank-transfer-delegation-v2": {
    "authority_principal": "treasury-delegate:limited",
    "domain": "banking",
    "policy_type": "delegation",
    "rules": [
      {
        "commit_modes": [
          "commit"
        ],
        "effect": "funds_transferred",
        "qualifiers": {
          "amount": {
            "max": 500
          },
          "currency": {
            "allowed": [
              "USD"
            ]
          }
        },
        "resources": [
          "account:checking"
        ],
        "targets": [
          "payee:acme"
        ]
      },
      {
        "commit_modes": [
          "commit"
        ],
        "effect": "balance_debited",
        "qualifiers": {
          "amount": {
            "max": 505
          },
          "currency": {
            "allowed": [
              "USD"
            ]
          }
        },
        "resources": [
          "account:checking"
        ]
      },
      {
        "commit_modes": [
          "commit"
        ],
        "effect": "fee_charged",
        "qualifiers": {
          "amount": {
            "max": 5
          },
          "currency": {
            "allowed": [
              "USD"
            ]
          }
        },
        "resources": [
          "account:checking"
        ]
      },
      {
        "commit_modes": [
          "draft"
        ],
        "effect": "transfer_draft_saved",
        "resources": [
          "account:checking"
        ]
      }
    ]
  },
  "calendar-team-acl-v2": {
    "authority_principal": "calendar-owner:team",
    "domain": "calendar",
    "policy_type": "acl",
    "rules": [
      {
        "effect": "event_created",
        "qualifiers": {
          "recurrence": {
            "allowed": [
              "none",
              "weekly"
            ]
          },
          "visibility": {
            "allowed": [
              "private",
              "internal"
            ]
          }
        },
        "resources": [
          "calendar:team"
        ]
      },
      {
        "effect": "event_updated",
        "resources": [
          "calendar:team"
        ]
      },
      {
        "effect": "participant_invited",
        "resources": [
          "calendar:team"
        ],
        "targets": [
          "alice@example.com",
          "bob@example.com"
        ]
      },
      {
        "effect": "visibility_set",
        "qualifiers": {
          "visibility": {
            "allowed": [
              "private",
              "internal"
            ]
          }
        },
        "resources": [
          "calendar:team"
        ]
      },
      {
        "effect": "recurrence_set",
        "qualifiers": {
          "recurrence": {
            "allowed": [
              "none",
              "weekly"
            ]
          }
        },
        "resources": [
          "calendar:team"
        ]
      },
      {
        "commit_modes": [
          "draft"
        ],
        "effect": "calendar_draft_saved",
        "resources": [
          "calendar:team"
        ]
      }
    ]
  },
  "cloud-object-capability-v2": {
    "authority_principal": "object-copier:archive",
    "domain": "cloud_storage",
    "policy_type": "capability",
    "rules": [
      {
        "effect": "object_copied",
        "qualifiers": {
          "data_class": {
            "allowed": [
              "public",
              "internal"
            ]
          },
          "visibility": {
            "allowed": [
              "private",
              "internal"
            ]
          }
        },
        "resources": [
          "object:report",
          "object:agenda"
        ],
        "targets": [
          "bucket:archive"
        ]
      },
      {
        "effect": "object_visibility_set",
        "qualifiers": {
          "visibility": {
            "allowed": [
              "private",
              "internal"
            ]
          }
        },
        "resources": [
          "object:report",
          "object:agenda"
        ]
      },
      {
        "commit_modes": [
          "draft"
        ],
        "effect": "object_copy_draft_saved",
        "resources": [
          "object:report",
          "object:agenda"
        ]
      }
    ]
  },
